# Production canonical URL. Leave unset in local development.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Supabase project URL and public anon/publishable key (safe for the browser).
# Never put SUPABASE_SERVICE_ROLE_KEY, passwords, or admin secrets in NEXT_PUBLIC_*
# or any client-accessible file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer Supabase projects expose a publishable key instead of the anon JWT.
# The app accepts either name:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional deploy pin when Host does not match portfolio_site_domains.
# Public routing prefers: Host → portfolio_site_domains → this slug → owner site.
# Prefer the server-only name. NEXT_PUBLIC_PORTFOLIO_SITE_SLUG is accepted as a fallback.
# Do NOT use website_name / brand_name here — those are content, not routing.
PORTFOLIO_SITE_SLUG=

# Owner admin email for the preserved production portfolio (server-only).
# Defaults to ADMIN_EMAIL when unset. Customers must use a different Auth email
# and an isolated site (see supabase/seeds/grant_admin.example.sql).
OWNER_ADMIN_EMAIL=

# Server-only allowlist for the primary admin Auth user email.
# Do not prefix this with NEXT_PUBLIC_. Do not put a password or service-role key here.
# Must match the Supabase Auth user and your grant-admin SQL.
# On Hostinger: Website dashboard → Environment variables → add ADMIN_EMAIL, then Redeploy.
# Additional customer admins are authorized via portfolio_admins (not by sharing this site).
ADMIN_EMAIL=

# Stable Server Action encryption key for self-hosted / Hostinger deploys.
# Required to prevent "Failed to find Server Action ... older or newer deployment"
# after rebuilds. Generate once and keep it fixed across deploys:
#   openssl rand -base64 32
# Set this in Hostinger → Environment variables BEFORE Redeploy (needed at build time).
# Do not prefix with NEXT_PUBLIC_. Do not commit the real key.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
